# Browser-safe Supabase configuration (real mode only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Local demo requires loopback hostname; never enable on a public deployment.
DEMO_MODE=false
ALLOW_LOCAL_DEMO=false
OWNER_USER_ID=
OWNER_EMAIL=
SCRAPING_ENABLED=false
MONTHLY_BUDGET_USD=4.00
DEFAULT_TIMEZONE=Asia/Kolkata

# App server only: same value as the Edge INTERNAL_CRON_SECRET; never NEXT_PUBLIC_*.
REELRADAR_DISPATCH_SECRET=

# Worker secrets: configure in Supabase Edge Functions, NOT NEXT_PUBLIC_*.
# Do not assume Vercel environment variables propagate to Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REELRADAR_OWNER_USER_ID=
INTERNAL_CRON_SECRET=
PROVIDER_MODE=apify
ENVIRONMENT=production
APIFY_API_TOKEN=
# Optional authorized fallback accounts. Worker-only secrets; never add to Next/client config.
APIFY_API_TOKEN_2=
APIFY_API_TOKEN_3=
APIFY_API_TOKEN_4=
APIFY_API_TOKEN_5=
# Account IDs and verified usage are registered by authenticated configure_accounts, not token rotation.
APIFY_ACCOUNT_ID=
APIFY_REEL_ACTOR_RESOURCE_ID=
APIFY_PROFILE_ACTOR_RESOURCE_ID=
APIFY_WEBHOOK_SHARED_SECRET=
PROVIDER_VALIDATED=false
CAROUSEL_PROVIDER_VALIDATED=false
# Enable only after authoritative account usage and provider-enforced caps are verified.
RUN_CHARGE_CAP_VALIDATED=false
ACCOUNT_USAGE_VALIDATED=false
PROFILE_PROVIDER_VALIDATED=false
# Optional profile overrides; blank values use documented minimal-profile defaults.
PROFILE_INPUT_BASE_JSON=
PROFILE_INPUT_USERNAMES_KEY=usernames
PROFILE_INPUT_FORMAT=usernames
PROFILE_OUTPUT_MAPPING_JSON={"username":"username","followers":"followersCount","display_name":"fullName","avatar_url":"profilePicUrl"}

# ElevenLabs transcript workers only. Keep live gates off until account/contract validation.
# Monthly ceilings are configured by each installation owner in SQL.
# A fresh install remains disabled until its provider and budget gates are verified.
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_WEBHOOK_SECRET=
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_PROVIDER_VALIDATED=false

# Operator CLI only: explicitly pin your project HTTPS origin in .env.worker.local.
EXPECTED_SUPABASE_ORIGIN=
